# Идентификатор клиента (используется как имя Docker project)
CLIENT_ID=client1

# Порты на хосте — у каждого клиента должны быть уникальные
N8N_PORT=5678
USERBOT_PORT=8000
PORTAL_PORT=7000

# Telegram API — получить на https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Домен для n8n (используется для webhook URL)
N8N_DOMAIN=

# Не менять — Docker-сеть resolves имя сервиса n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook/telegram-incoming
N8N_DELIVERY_WEBHOOK_URL=http://n8n:5678/webhook/telegram-delivery

SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
SESSIONS_DIR=sessions

# Портал — логин/пароль для входа
PORTAL_USERNAME=client1
PORTAL_PASSWORD=
JWT_SECRET=
