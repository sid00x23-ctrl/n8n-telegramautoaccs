      "id": "w2-gs",
      "name": "Read Warmup Pairs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        144,
        -384
      ],
      "retryOnFail": true,
      "waitBetweenTries": 3000,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "pUUUlMTR22IlRpbY",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\n\nconst accountsItem = items.find(i => Array.isArray(i.json.accounts));\nconst allAccounts = accountsItem?.json?.accounts || [];\nconst accountMap = {};\nfor (const acc of allAccounts) {\n  accountMap[acc.account_id] = acc;\n}\nconst pairs = items.filter(i => !Array.isArray(i.json.accounts)).map(i => i.json);\n\nreturn pairs\n  .filter(p => String(p.status).trim().toLowerCase() === 'active')\n  .filter(p => !p.next_send_time || new Date(p.next_send_time) <= now)\n  .filter(p => {\n    const initiator = accountMap[p.initiator_id];\n    const partner = accountMap[p.partner_id];\n    return initiator?.warmup_initiator === true && partner?.warmup_receiver === true;\n  })\n  .map(p => {\n    // last_sender === initiator_id означает, что следующим пишет partner, и наоборот\n    const partnerSends = (p.last_sender === p.initiator_id);\n\n    const sender_id = partnerSends ? p.partner_id : p.initiator_id;\n    const receiver_username = partnerSends ? p.initiator_id : p.partner_id;\n\n    const nextSendTime = new Date(now.getTime() + (45 + Math.random() * 30) * 60000).toISOString();\n\n    return {\n      json: {\n        pair_id: p.pair_id,\n        initiator_id: p.initiator_id,\n        partner_id: p.partner_id,\n        sender_id,\n        receiver_username, // <-- используем это в узле отправки сообщения\n        next_send_time_new: nextSendTime,\n        last_message_text: p.last_message_text || 'привет',\n        row_number: p.row_number,\n      }\n    };\n  });"
      },
