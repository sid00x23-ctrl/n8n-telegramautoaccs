    {
      "parameters": {
        "jsCode": "const now = new Date();\n// Item from Aggregate Accounts has .accounts field\n// Items from Read Warmup Pairs have pair fields\nconst accountItem = items.find(i => Array.isArray(i.json.accounts));\nconst allAccounts = accountItem?.json?.accounts || [];\nconst available = allAccounts.filter(a => a.available);\nconst availableIds = new Set(available.map(a => a.account_id));\nconst initiators = available.filter(a => a.warmup_initiator === true);\nconst warmupPairs = items.filter(i => !Array.isArray(i.json.accounts)).map(i => i.json);\nconst result = [];\n\nfor (const initiator of initiators) {\n  const usedPartners = new Set(\n    warmupPairs.filter(p => p.initiator_id === initiator.account_id).map(p => p.partner_id)\n  );\n  const candidates = available.filter(a =>\n    a.account_id !== initiator.account_id &&\n    !usedPartners.has(a.account_id) &&\n    a.warmup_receiver === true\n  );\n  if (!candidates.length) continue;\n  const partner = candidates[Math.floor(Math.random() * candidates.length)];\n  const pairId = `${initiator.account_id}_${partner.account_id}_${Date.now()}`;\n  const nextSendTime = new Date(now.getTime() + (45 + Math.random() * 30) * 60000).toISOString();\n\n  result.push({\n    json: {\n      pair_id: pairId,\n      initiator_id: initiator.account_id,\n      initiator_tg_id: Number(initiator.tg_id),\n      partner_id: partner.account_id,\n      partner_tg_id: Number(partner.tg_id),\n      partner_username: partner.username || '',\n      sender_id: initiator.account_id,           // <-- первым пишет инициатор\n      receiver_username: partner.username || '',  // <-- получает партнёр\n      created_at: now.toISOString(),\n      next_send_time: nextSendTime,\n    }\n  });\n}\nreturn result;"
      },
