    {
      "parameters": {
        "jsCode": "const llmText = $input.first().json.text;\nconst userIds = $('Aggregate').first().json['User ID'];\n\nconst lines = llmText.trim().split('\\n');\nconst results = [];\n\nfor (let i = 0; i < userIds.length; i++) {\n  const line = lines[i] || '';\n  const match = line.match(/^\\d+\\.\\s*(.+)/);\n  const name = match ? match[1].trim() : '-';\n  \n  results.push({\n    json: {\n      'User ID': String(userIds[i]),\n      'Имя(для рассылки)': name\n    }\n  });\n}\n\nreturn results;"
      },
