    {
      "parameters": {
        "promptType": "define",
        "text": "=Определи пол для каждого человека из списка ниже.\nОтветь ТОЛЬКО пронумерованным списком в формате: номер. М/Ж/-\nНе добавляй ничего лишнего.\n\nПравила:\n- М — мужской\n- Ж — женский\n- - — невозможно определить (если имя нечитаемо, является профессией или не является именем)\n\nСписок:\n{{ $json['Имя'].map((name, i) => `${i+1}. ${name} ${$json['Фамилия'][i]}`).join('\\n') }}",
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
