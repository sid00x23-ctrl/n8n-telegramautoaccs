    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst seen = new Set();\nconst result = [];\n\nfor (const item of items) {\n  const userId  = item.json['UserID'];\n  const account = item.json['Аккаунт'];\n\n  if (!userId || String(userId).trim() === '') continue;\n  if (!account || String(account).trim() === '') continue;\n\n  // Один клиент на аккаунт за цикл\n  if (seen.has(account)) continue;\n  seen.add(account);\n\n  result.push(item);\n}\n\nconsole.log(`К отправке: ${result.length} (аккаунтов: ${seen.size})`);\nreturn result;"
      },
