    {
      "parameters": {
        "jsCode": "const account_id = $('Loop: аккаунты').item.json.account_id;\nconst raw = $input.first().json;\n// API возвращает массив [{id, text, out, date, read}]\nconst msg = Array.isArray(raw) ? (raw[0] || {}) : (raw || {});\n// Берём входящее сообщение (out=false) от SpamBot\nconst text = (msg.out === false && msg.text) ? msg.text : '';\nreturn [{ json: { account_id, text } }];"
      },
      "id": "extract-text-01",
      "name": "Code: извлекаем текст",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        240
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Извлеки дату окончания спам-бана из сообщения Telegram SpamBot. Верни ТОЛЬКО валидный JSON без markdown и пояснений: {\"banned_until\": \"<ISO 8601 UTC datetime>\", \"parsed\": true} если дата найдена, или {\"banned_until\": null, \"parsed\": false} если нет.\n\nСообщение SpamBot: {{ $json.text || 'пусто' }}",
        "batching": {}
      },
      "id": "llm-chain-01",
      "name": "Basic LLM Chain: парсим дату бана",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1168,
        240
      ],
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const account_id = $('Code: извлекаем текст').item.json.account_id;\nconst raw = $input.first().json.text || $input.first().json.output || '';\ntry {\n  const cleaned = raw.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  const result = JSON.parse(cleaned);\n  const banned_until = result.banned_until || null;\n  return [{ json: { account_id, banned_until, parsed: !!banned_until } }];\n} catch (e) {\n  return [{ json: { account_id, banned_until: null, parsed: false, raw_text: raw.slice(0, 200) } }];\n}"
      },
      "id": "normalize-llm-01",
      "name": "Code: нормализуем ответ LLM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-parsed-01",
              "leftValue": "={{ $json.parsed }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-date-01",
      "name": "IF: дата бана получена?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1680,
        240
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=http://127.0.0.1:8000/accounts/{{ $json.account_id }}/spam_ban",
