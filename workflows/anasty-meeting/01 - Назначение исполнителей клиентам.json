    {
      "parameters": {
        "jsCode": "// Берём только доступные аккаунты (authorized + не под спам-баном)\nconst accountsList = $('Агрегируем аккаунты').item.json.accounts || [];\nconst available = accountsList.filter(a => a.available === true);\n\nif (!available.length) {\n  throw new Error('Нет доступных аккаунтов в сервисе (все авторизованы или под спам-баном)');\n}\n\n// Клиенты из GSheets\nconst clients = $input.all().filter(c =>\n  String(c.json['UserID'] || '').trim() !== ''\n);\n\nif (!clients.length) {\n  console.log('Нет новых клиентов для назначения');\n  return [];\n}\n\n// Берём ровно столько клиентов, сколько доступных аккаунтов\nconst toAssign = clients.slice(0, available.length);\nconst now = new Date().toLocaleString('sv-SE', { timeZone: 'Europe/Moscow' }).substring(0, 16);\n\nconsole.log(`Назначаем: ${toAssign.length} клиентов на ${available.length} аккаунтов`);\n\nreturn toAssign.map((c, i) => ({\n  json: {\n    ...c.json,\n    executor_bot_id: available[i].account_id,\n    Аккаунт: available[i].account_id,\n    Статус: 'assigned',\n    Дата_контакта: now,\n  }\n}));"
      },
