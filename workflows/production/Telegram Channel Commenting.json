        "jsonBody": "={{ JSON.stringify({ account_id: $('Check Duplicate').first().json.account_id, channel: $('Check Duplicate').first().json.channel, post_id: $('Check Duplicate').first().json.post.post_id, text: $json.text }) }}",
        "options": {}
