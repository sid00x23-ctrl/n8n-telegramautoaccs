    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst accounts = $('Filter Accounts').first().json.accounts;\n\nconst channelUrl = row.channel_url || '';\n\n// Случайный аккаунт\nconst account = accounts[Math.floor(Math.random() * accounts.length)];\nconst account_id = account.account_id;\n\nreturn [{\n  json: {\n    channel_url: channelUrl,\n    channel: channelUrl,\n    account_id,\n    last_comment_date: row.last_comment_date || null,\n    comment_count: parseInt(row.comment_count) || 0,\n  }\n}];"
      },
      "id": "node-07",
      "name": "Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        304
      ]
    },
    {
      "parameters": {
        "url": "={{ 'http://127.0.0.1:8000/commenting/last_post?channel=' + encodeURIComponent($json.channel) + '&account_id=' + $json.account_id }}",
        "options": {}
      },
      "id": "node-13",
      "name": "Get Last Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1344,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const postResponse = $input.first().json;\nconst prepared = $('Prepare').first().json;\n\nconst post = postResponse.post || null;\nconst lastCommentDate = prepared.last_comment_date;\nconst shouldComment = post !== null && (!lastCommentDate || new Date(post.date) > new Date(lastCommentDate));\n\nreturn [{\n  json: {\n    channel_url: prepared.channel_url,\n    channel: prepared.channel,\n    account_id: prepared.account_id,\n    last_comment_date: lastCommentDate,\n    comment_count: prepared.comment_count,\n    post,\n    should_comment: Boolean(shouldComment),\n  }\n}];"
      },
      "id": "node-14",
      "name": "Check Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
