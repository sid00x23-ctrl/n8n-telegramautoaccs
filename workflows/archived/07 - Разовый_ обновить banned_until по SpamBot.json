      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -800,
        320
      ],
      "parameters": {}
    },
    {
      "id": "get-accounts-01",
      "name": "HTTP: список аккаунтов",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -600,
        320
      ],
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8000/accounts",
        "options": {}
      }
    },
    {
      "id": "filter-banned-01",
      "name": "Code: фильтр забаненных",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        320
      ],
      "parameters": {
        "jsCode": "const now = new Date();\nreturn $input.all()\n  .filter(item => {\n    const b = item.json.banned_until;\n    return b && new Date(b) > now;\n  })\n  .map(item => ({ json: { account_id: item.json.account_id, banned_until_old: item.json.banned_until } }));"
      }
    },
    {
      "id": "split-batches-01",
      "name": "По одному аккаунту",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -200,
        320
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "send-start-01",
      "name": "HTTP: /start → SpamBot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        320
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/send",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "account_id",
              "value": "={{ $json.account_id }}"
            },
            {
              "name": "chat_id",
              "value": "178220800"
            },
            {
              "name": "text",
              "value": "/start"
            },
            {
              "name": "instant",
              "value": "true"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "wait-spambot-01",
      "name": "Wait: 5 сек",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        200,
        320
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 5,
        "unit": "seconds"
      }
    },
    {
      "id": "read-msg-01",
      "name": "HTTP: читаем ответ SpamBot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        320
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "=http://127.0.0.1:8000/accounts/{{ $('По одному аккаунту').item.json.account_id }}/dialogs/178220800/messages",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "3"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "parse-date-01",
      "name": "Code: парсим дату бана",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        320
      ],
      "parameters": {
        "jsCode": "const account_id = $('По одному аккаунту').item.json.account_id;\n\nconst incoming = $input.all()\n  .filter(item => !item.json.out)\n  .sort((a, b) => new Date(b.json.date) - new Date(a.json.date));\n\nif (!incoming.length) {\n  return [{ json: { account_id, banned_until: null, parsed: false } }];\n}\n\nconst text = incoming[0].json.text || '';\nconst match = text.match(/limited until (\\d{1,2} \\w{3} \\d{4}), (\\d{2}:\\d{2}) UTC/);\n\nif (!match) {\n  return [{ json: { account_id, banned_until: null, parsed: false, raw_text: text.slice(0, 200) } }];\n}\n\nconst banned_until = new Date(`${match[1]} ${match[2]} UTC`).toISOString();\nreturn [{ json: { account_id, banned_until, parsed: true } }];"
      }
    },
    {
      "id": "if-date-01",
      "name": "IF: дата получена?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        840,
        320
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-parsed",
              "leftValue": "={{ $json.parsed }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "patch-ban-01",
      "name": "HTTP: обновляем banned_until",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        200
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "PATCH",
        "url": "=http://127.0.0.1:8000/accounts/{{ $json.account_id }}/spam_ban",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ banned_until: $json.banned_until }) }}",
        "options": {}
      }
    },
    {
