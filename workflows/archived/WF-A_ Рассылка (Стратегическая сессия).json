    {
      "parameters": {
        "jsCode": "const userId = String($json['UserID'] || '').replace(/'/g, \"''\");\nconst msgText = String($json['message_text'] || '').replace(/'/g, \"''\");\n\nconst messageJson = JSON.stringify({\n  type: 'ai',\n  data: {\n    content: $json['message_text'] || '',\n    additional_kwargs: {}\n  }\n}).replace(/'/g, \"''\");\n\nreturn [{\n  json: {\n    ...$json,\n    pg_query: `INSERT INTO n8n_chat_histories (session_id, message) VALUES ('${userId}', '${messageJson}'::jsonb)`\n  }\n}];"
