    {
      "parameters": {
        "jsCode": "const accountsList = $('Агрегируем аккаунты').first().json.accounts || [];\nconst available = accountsList.filter(a => a.available === true);\n\nif (!available.length) {\n  console.log('Нет доступных аккаунтов');\n  return [];\n}\n\nconst leads = $input.all().filter(c => String(c.json['UserID'] || '').trim() !== '');\n\nif (!leads.length) {\n  console.log('Нет новых лидов');\n  return [];\n}\n\nconst toAssign = leads.slice(0, available.length);\nconst now = new Date().toLocaleString('sv-SE', { timeZone: 'Europe/Moscow' }).substring(0, 16);\n\nconsole.log(`Назначаем: ${toAssign.length} лидов на ${available.length} аккаунтов`);\n\nreturn toAssign.map((c, i) => ({\n  json: {\n    ...c.json,\n    executor_bot_id: available[i].account_id,\n    Аккаунт: available[i].account_id,\n    Дата_контакта: now,\n  }\n}));"
      },
