# Telegram API — получить на https://my.telegram.org/apps
# (одни ключи на всё приложение, не на каждый аккаунт)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Внутри Docker-сети: имя сервиса n8n — это хост
N8N_WEBHOOK_URL=http://n8n:5678/webhook/telegram-incoming
N8N_DELIVERY_WEBHOOK_URL=http://n8n:5678/webhook/telegram-delivery

# Сервис
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
SESSIONS_DIR=sessions
