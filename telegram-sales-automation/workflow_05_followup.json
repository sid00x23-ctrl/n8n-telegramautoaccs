    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst oneHourAgo = Date.now() - 60 * 60 * 1000;\nreturn items.filter(item => {\n  const dateStr = item.json['Дата контакта'];\n  if (!dateStr) return false;\n  const padded = dateStr.replace(/(\\d{4}-\\d{2}-\\d{2}) (\\d):/, '$1 0$2:');\n  const utcDate = new Date(padded.replace(' ', 'T') + ':00+03:00');\n  return utcDate.getTime() < oneHourAgo;\n});"
      },
