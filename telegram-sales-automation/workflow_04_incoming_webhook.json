      "parameters": {
        "jsCode": "const messages = $('Читаем буфер').item.json.messages;\nconst chatId = $('Нормализуем входящие данные').item.json.chat_id;\nconst accountId = $('Нормализуем входящие данные').item.json.account_id;\n\nconst msgsArray = Array.isArray(messages) ? messages : [messages ?? ''];\nconst messagesText = msgsArray.join('\\n---\\n');\n\nreturn [{ json: {\n  chat_id: chatId,\n  account_id: accountId,\n  message_count: msgsArray.length,\n  messages_text: messagesText\n} }];"
      },
