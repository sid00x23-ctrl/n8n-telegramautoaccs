          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Авторизованные аккаунты из сервиса (агрегированы в один item)\nconst accountsList = $('Агрегируем аккаунты').item.json.accounts || [];\nconst authorized = accountsList.filter(a => a.authorized === true);\n\nif (!authorized.length) {\n  throw new Error('Нет авторизованных аккаунтов в сервисе');\n}\n\n// Клиенты из GSheets\nconst clients = $input.all().filter(c =>\n  String(c.json['User_id'] || '').trim() !== ''\n);\n\nif (!clients.length) {\n  console.log('Нет новых клиентов для назначения');\n  return [];\n}\n\n// Stateful round-robin: счётчик сохраняется между запусками\nconst state = $getWorkflowStaticData('global');\nlet idx = Number(state.rrIndex ?? 0);\n\nconst now = new Date().toLocaleString('sv-SE', { timeZone: 'Europe/Moscow' }).substring(0, 16);\n\nconst result = clients.map(c => {\n  const account = authorized[idx % authorized.length];\n  idx++;\n  return {\n    json: {\n      ...c.json,\n      executor_bot_id: account.account_id,\n      Аккаунт: account.account_id,\n      Статус: 'assigned',\n      Дата_контакта: now,\n    }\n  };\n});\n\nstate.rrIndex = idx;\nreturn result;"
      },
